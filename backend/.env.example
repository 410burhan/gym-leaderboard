# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings -> API, and the "Connect" button at the top of your project dashboard).

# From the "Connect" button -> Connection String tab -> Session pooler.
# (Session pooler, not Transaction pooler: this backend is a persistent
# long-running process, not a serverless/edge function making short-lived
# connections - Transaction pooler is the wrong mode for it.)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# From Project Settings -> API -> JWT Keys: use the "Legacy JWT Secret" (HS256
# shared secret) if your project still exposes one - that's what this backend
# verifies against. If your project only offers the newer asymmetric Signing
# Keys with no legacy secret visible, this needs a different verification
# approach (JWKS-based, ES256) - ask for that change instead of guessing here.
SUPABASE_JWT_SECRET=your-jwt-secret-from-project-settings-api
SUPABASE_URL=https://your-project-ref.supabase.co
CORS_ORIGINS=http://localhost:5173
