# Copy this file to .env and fill in real values from your Supabase project.

# From the "Connect" button at the top of your project dashboard -> Connection
# String tab -> Session pooler. (Session pooler, not Transaction pooler: this
# backend is a persistent long-running process, not a serverless/edge
# function making short-lived connections.)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Project Settings -> API -> Project URL. The backend uses this to fetch
# Supabase's public JWKS (JSON Web Key Set) and verify JWT signatures against
# it - no shared secret needed, since this project's tokens are signed with
# an asymmetric key (ES256).
SUPABASE_URL=https://your-project-ref.supabase.co

CORS_ORIGINS=http://localhost:5173
